VAL_ 168 ST_TORQ_AVL 0 "intervention request executed" 1 "intervention ignition request not executed" 2 "intervention injection request not executed" 3 "intervention ignition and injection request not executed" 15 "signal invalid" ;
VAL_ 168 ST_DMEA_SWO 0 "no error" 1 "shutdown because of error" ;
VAL_ 169 ST_SW_LEV_RPM 0 "idle speed > the treshold value" 1 "idle speed < the treshold value" ;
VAL_ 169 ST_INFS 0 "no action" 1 "thrust cutoff active" ;
VAL_ 170 ANG_ACPD 0 "unpressed" 255 "pedal on the floor" ;
VAL_ 170 RPM_ENG_ERR 0 "signal clear and correct" 1 "speed sensor defective" 3 "signal invalid" ;
VAL_ 170 ST_IDLG_ENG 0 "idle" 1 "no idle" 3 "signal invalid" ;
VAL_ 170 ST_CLCTR_V 0 "acc regulation, pedal not pressed" 1 "acc regulation, pedal pressed" 4 "cc regulation, retard" 5 "cc regulation, constant speed" 6 "cc regulation, recall" 7 "cc regulation, speed up" 8 "pedal not pressed" 9 "pedal pressed" 10 "pedal transgress" 11 "pedal kickdown" ;
VAL_ 182 TORQ_TAR_DSC -2048 "No request (raw 0x800)" ;
